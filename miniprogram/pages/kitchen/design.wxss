.intro-pet{position:absolute;right:8rpx;bottom:38rpx;width:213.6rpx;height:213.6rpx;pointer-events:none}.intro-pet asset-image{position:relative;z-index:1}
.dinner-settings{display:flex;align-items:center;gap:12rpx;padding:9.6rpx 9.6rpx 9.6rpx 28.8rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:31.2rpx}
.setting-label{font-size:28.8rpx;color:var(--muted-ink);white-space:nowrap;margin-right:auto}.serving-segments{display:flex;gap:4.8rpx}.serving-choice{font-size:28.8rpx;min-width:52.8px;padding:12rpx 16.8rpx;border-radius:21.6rpx}.serving-choice.active{background:var(--surface-2);color:var(--accent);font-weight:700}.preferences-button{min-width:52.8px;width:52.8px;padding:0;color:var(--muted-ink);border-left:1rpx solid var(--line);border-radius:0}
.filter-icon{width:34.8rpx;height:24rpx;border-top:2rpx solid currentColor;border-bottom:2rpx solid currentColor;position:relative}.filter-icon::before,.filter-icon::after{content:'';position:absolute;width:7.2rpx;height:7.2rpx;border:2rpx solid currentColor;border-radius:50%;background:var(--surface)}.filter-icon::before{left:4rpx;top:-5rpx}.filter-icon::after{right:3rpx;bottom:-5rpx}
.taste-scroll{width:100%;margin:19.2rpx 0 28.8rpx;white-space:nowrap}.taste-row{display:inline-flex;gap:14.4rpx;padding:2.4rpx}.taste-choice{font-size:28.8rpx;border-radius:72rpx;padding:12rpx 30rpx;flex:none;color:var(--muted-ink);background:transparent;border:1rpx solid transparent}.taste-choice.active{color:var(--accent);border-color:var(--accent-2);background:var(--surface-2)}
.wheel-caption{display:flex;align-items:center;justify-content:space-between;padding:0 7.2rpx;margin:2.4rpx 0 24rpx}.wheel-caption-label{font-size:30rpx;font-weight:500}.wheel-caption .caption{font-size:26.4rpx}
.wheel-stage{position:relative;width:751.2rpx;height:751.2rpx;margin:0 auto 36rpx;border:1rpx solid var(--line);border-radius:50%;padding:7.2rpx;background:var(--surface)}
.wheel-disc{position:absolute;inset:6rpx;transition-property:transform;transition-timing-function:cubic-bezier(.12,.72,.12,1);border-radius:50%;overflow:hidden}
.wheel-canvas{display:block;width:100%;height:100%}.wheel-label{position:absolute;width:139.2rpx;text-align:center;pointer-events:none;transition-property:transform;transition-timing-function:cubic-bezier(.12,.72,.12,1);font-size:28.8rpx;line-height:1.6;font-weight:500;color:var(--ink);z-index:1}.wheel-label text{display:block;max-height:93.6rpx;overflow:hidden;word-break:break-all}
.wheel-pointer{position:absolute;left:50%;transform:translateX(-50%);width:28.8px;height:38.4px;z-index:13;pointer-events:none}
.pointer-spring{position:relative;width:100%;height:100%;transform-origin:50% 7px;transition-property:transform}
.pointer-blade{position:absolute;left:3px;top:7px;width:21.6px;height:21.6px;background:var(--surface);border:1px solid var(--accent);border-radius:12px 12px 3.6px 12px;transform:rotate(45deg);box-shadow:1px 1px 2px var(--line)}
.pointer-inlay{position:absolute;inset:3px;border-radius:7.2px 7.2px 2.4px 7.2px;background:linear-gradient(135deg,var(--accent-2),var(--accent))}
.pointer-pivot{position:absolute;left:6px;top:1px;width:14.4px;height:14.4px;border:1px solid var(--accent);border-radius:50%;background:var(--surface);display:flex;align-items:center;justify-content:center}
.pointer-pivot-dot{width:4.8px;height:4.8px;border-radius:50%;background:var(--accent)}
.wheel-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:153.6rpx;height:153.6rpx;border-radius:50%;background:var(--surface);color:var(--accent);border:6rpx solid var(--bg);font-size:27.6rpx;padding:0;flex-direction:column;gap:12rpx;z-index:2;box-shadow:var(--shadow)}.wheel-center .bowl-symbol{width:43.2rpx;height:24rpx;margin-top:16.8rpx}.wheel-center>text{white-space:nowrap}
.wheel-bottom{margin-top:auto;padding-top:2.4rpx}.spin-button{width:100%;min-height:124.8rpx;border-radius:31.2rpx;display:flex;justify-content:center;gap:36rpx;font-size:36rpx;letter-spacing:1rpx}.button-arrow{font-family:sans-serif;font-size:43.2rpx;font-weight:400}.wheel-hint{display:block;text-align:center;font-size:26.4rpx;color:var(--muted-ink);margin:21.6rpx 0 0;line-height:1.7}
@media(max-height:820px){.wheel-topbar{margin-bottom:21.6rpx}.wheel-intro{margin-bottom:28.8rpx;min-height:216rpx}.wheel-title{font-size:86.4rpx}.wheel-intro .eyebrow{margin-bottom:12rpx}.wheel-subtitle{margin-top:14.4rpx}.intro-pet{width:187.2rpx;height:187.2rpx;bottom:26rpx}.taste-scroll{margin-bottom:16.8rpx}.wheel-stage{width:681.6rpx;height:681.6rpx;margin-bottom:26.4rpx}.wheel-caption{margin-bottom:19.2rpx}.wheel-label{font-size:27.6rpx;width:127.2rpx}.wheel-hint{margin-top:14.4rpx}}
@media(prefers-reduced-motion:reduce){.wheel-disc,.wheel-label{transition-duration:0ms!important}}

.taste-scroll::-webkit-scrollbar{display:none}.taste-scroll{scrollbar-width:none}
.wheel-line{display:block}
@media(min-width:410px) and (max-height:870px){.wheel-stage{width:681.6rpx;height:681.6rpx;margin-bottom:26.4rpx}.wheel-intro{margin-bottom:28.8rpx}.wheel-topbar{margin-bottom:26.4rpx}}

.menu-strip::-webkit-scrollbar,.category-scroll::-webkit-scrollbar{display:none}.menu-strip,.category-scroll{scrollbar-width:none}

/* Each pet has its own objects, surface shape and illustration language. */
.theme-brand-icon{width:72rpx;height:72rpx;flex:none}.theme-nav-icon{width:72rpx;height:72rpx;opacity:.66;transition:transform 160ms ease,opacity 160ms ease}.nav-item.active{background:var(--surface-2);font-weight:700}.nav-item.active .theme-nav-icon{opacity:1;transform:translateY(-3rpx)}.nav-item.active::after{display:none}
.bottom-nav{max-width:612px;margin:0 auto;min-height:81px;padding:5px}.nav-item{gap:2px;min-height:69px;padding:4px 0}.nav-item .theme-nav-icon{width:36px;height:36px}.nav-item>text{line-height:16.8px}.theme-spin-icon{width:76.8rpx;height:67.2rpx}.wheel-center{gap:2.4rpx}.theme-summary{display:flex;align-items:center;justify-content:space-between;background:var(--surface-2);border-radius:var(--card-radius);padding:28.8rpx 33.6rpx;gap:14.4rpx}.theme-summary .section-title,.theme-summary .caption{display:block}.theme-summary .section-title{font-family:Lemi,sans-serif;font-size:50.4rpx;margin:7.2rpx 0}.theme-decoration{width:132rpx;height:132rpx;flex:none}.pet-card{position:relative;background:var(--pet-bg);border-color:var(--pet-line);border-radius:var(--card-radius);color:var(--ink);padding:21.6rpx 14.4rpx}.pet-card.active{background:var(--pet-bg);border-color:var(--pet-accent);box-shadow:inset 0 0 0 1rpx var(--pet-accent)}.pet-theme-name{font-size:27.6rpx;color:var(--pet-accent);margin-top:4.8rpx}.pet-swatches{display:flex;gap:9.6rpx;margin:16.8rpx 0}.pet-swatches text{display:block;width:26.4rpx;height:14.4rpx;border-radius:7.2rpx}.pet-selected{font-size:25.2rpx;color:var(--pet-accent);padding:4.8rpx 21.6rpx;border:1rpx solid var(--pet-line);border-radius:36rpx}.pet-card.active .pet-selected{background:var(--pet-accent);color:#fff}.intro-pet asset-image{display:block;position:relative;width:100%;height:100%}.dinner-settings,.spin-button,.match-card,.input{border-radius:var(--card-radius)}
.theme-strawberry .theme-summary{border:1rpx dashed var(--line-strong)}.theme-milk-tea .theme-summary{border:2rpx solid var(--line)}.theme-lazy-cat .theme-summary{background:var(--surface);border-bottom:2rpx solid var(--line-strong)}.theme-baozi .theme-summary{border:1rpx solid var(--line);box-shadow:none}.theme-baozi .pet-card{border-width:2.4rpx}
@media(prefers-reduced-motion:reduce){.theme-nav-icon{transition:none}}

.reduce-motion button,.reduce-motion .theme-nav-icon{transition:none}

/* Keep the original mascot beside the wheel, independent of disc rotation. */
.wheel-stage{margin-top:228rpx;overflow:visible}
.wheel-pet{position:absolute;left:50%;top:-195rpx;width:249.6rpx;height:249.6rpx;transform:translateX(-50%);z-index:12;pointer-events:none}
/* All v1.16.0 sequences share the same 150/160 ground baseline. */
.wheel-pet asset-image{display:block;width:100%;height:100%;transform-origin:50% 86%}
/* Body motion comes from the coherent source frames, without a second bounce. */
.reduce-motion .wheel-pet asset-image{animation:none}
@media(prefers-reduced-motion:reduce){.wheel-pet asset-image{animation:none}}

@media(min-width:410px) and (max-height:870px){.wheel-stage{width:631.2rpx;height:631.2rpx}}

/* Native compact controls: all choices fit the page, with no horizontal drag. */
.dinner-settings{display:block;padding:14.4rpx}
.setting-label{display:block;padding:4.8rpx 12rpx 9.6rpx;margin:0}
.serving-segments{display:flex;width:100%;gap:4.8rpx}
.app button.serving-choice{flex:1;min-width:0;padding:12rpx 4.8rpx}
.taste-heading,.taste-actions{display:flex;align-items:center;justify-content:space-between;gap:4.8rpx}
.taste-heading{margin-top:9.6rpx}
.taste-actions .text-button{font-size:27.6rpx;padding:9.6rpx 14.4rpx}
.taste-row{display:flex;flex-wrap:wrap;gap:12rpx;padding:0;margin:0 0 28.8rpx;white-space:normal}
.app button.taste-choice{flex:0 0 calc((100% - 30rpx)/4);min-width:0;min-height:52.8px;font-size:27.6rpx;padding:9.6rpx 2.4rpx;white-space:nowrap;border-color:var(--line)}
.app button.wheel-center{width:153.6rpx;height:153.6rpx;padding:0;flex:none}
.app button.spin-button{width:100%}
.app button.nav-item{flex:1;min-width:0}
.wheel-subtitle{white-space:normal}
.wheel-stage{flex-shrink:0}

/* The wheel is one fixed screen. Only separate preference sheets scroll. */
.wheel-screen{overflow:hidden}
.wheel-content{height:100%;min-height:0;overflow:hidden;padding:9.6px 16px 12px;display:flex;flex-direction:column}
.wheel-topbar{height:38.4px;flex:none;margin:0 0 4.8px}
.wheel-topbar .brand-name{font-size:20.4px}.wheel-topbar .theme-brand-icon{width:33.6px;height:33.6px}
.app .wheel-topbar button.close{width:36px;min-height:36px;height:36px;font-size:26.4px}
.wheel-intro{min-height:0;height:40.8px;flex:none;margin:0 0 7.2px}
.wheel-intro .eyebrow,.wheel-subtitle{display:none}
.wheel-title{font-size:31.2px;line-height:40.8px;letter-spacing:0;white-space:nowrap}
.accent-title{display:inline}
.dinner-settings{display:flex;align-items:center;flex:none;padding:2.4px 7.2px;height:43.2px;border-radius:14.4px}
.setting-label{font-size:14.4px;padding:0 9.6px 0 0;flex:none}
.serving-segments{flex:1;width:auto}
.app button.serving-choice{padding:2.4px;min-height:36px;font-size:15.6px}
.taste-heading{height:31.2px;margin:0;flex:none}.taste-heading .caption{font-size:13.2px}
.taste-actions .text-button{min-height:31.2px;padding:2.4px 7.2px;font-size:13.2px}
.taste-row{gap:4.8px;margin:0 0 6px;flex:none}
.app button.taste-choice{flex:0 0 calc((100% - 24px)/6);height:31.2px;min-height:31.2px;padding:0 1.2px;font-size:12px;border-radius:15.6px}
.wheel-caption{height:24px;flex:none;margin:0;padding:0}
.wheel-caption-label,.wheel-caption .caption{font-size:13.2px}
.wheel-play-area{position:relative;isolation:isolate;flex:1;min-height:0;display:flex;align-items:center;justify-content:flex-start;flex-direction:column;touch-action:none}
.wheel-stage{margin:0 auto;flex:none;touch-action:none;pointer-events:none}
.wheel-pet{margin:0;overflow:hidden}
/* White rim = disc inset + 26/1024 of disc diameter. Pivot center is 7px down. */
.wheel-pointer{top:calc(2.924rpx + 1.2695% - 8.4px)}
.wheel-label{font-size:16.5px;width:24%;line-height:1.4}.wheel-label text{max-height:none;overflow:visible}
.app button.wheel-center{width:76.8px;height:76.8px;min-height:0;font-size:14.4px}
.wheel-center .theme-spin-icon{width:36px;height:31.2px}
.wheel-bottom{margin:7.2px 0 0;padding:0;flex:none}
.app button.spin-button{min-height:45.6px;height:45.6px;font-size:18px;padding:4.8px 14.4px;border-radius:16.8px}
.wheel-hint{font-size:12px;line-height:19.2px;margin:3.6px 0 0}
@media(max-height:520px){.wheel-topbar{display:none}.wheel-title{font-size:27.6px}.wheel-intro{height:36px}.wheel-caption{display:none}}

/* Only the fingertip enters the center button at the bottom of its float. */
.wheel-tap-hand{position:absolute;left:50%;top:calc(50% - 80px);width:56px;height:56px;margin-left:-28px;z-index:15;pointer-events:none;animation:wheel-tap-cue 1600ms ease-in-out infinite}
.theme-strawberry .wheel-tap-hand{top:calc(50% - 82px)}
.theme-lazy-cat .wheel-tap-hand{top:calc(50% - 76px)}
@keyframes wheel-tap-cue{0%,100%{transform:translateY(-4px)}55%{transform:translateY(3px)}}
.reduce-motion .wheel-tap-hand{animation:none}
@media(prefers-reduced-motion:reduce){.wheel-tap-hand{animation:none}}

/* The face bevel belongs to the spinning disc; the frame casts the outer shadow. */
/* Outside: a broad, directional halo, independent of the face bevel. */
.wheel-stage{box-shadow:-9px -11px 27px rgba(69,53,43,.10),0 4px 0 rgba(45,49,56,.045),0 7px 13px rgba(45,49,56,.045)}
/* Inside: the overlay starts at the colored edge, leaving the white rim clean. */
.wheel-disc::after{content:'';position:absolute;inset:2.539%;border-radius:50%;pointer-events:none;z-index:1;box-shadow:inset 4px 5.333px .667px rgba(43,64,68,.105),inset -1px -2px 2px rgba(255,255,255,.55)}
.wheel-center-halo{position:absolute;left:50%;top:50%;width:76.8px;height:76.8px;box-sizing:border-box;border:1.5px solid var(--accent-2);border-radius:50%;pointer-events:none;z-index:2;opacity:0;animation:wheel-center-ripple 2400ms cubic-bezier(.2,.55,.3,1) infinite}
@keyframes wheel-center-ripple{0%{transform:translate(-50%,-50%) scale(.98);opacity:0}12%{opacity:.52}72%,100%{transform:translate(-50%,-50%) scale(1.68);opacity:0}}
.reduce-motion .wheel-center-halo,.q-paused .wheel-center-halo{display:none}
@media(prefers-reduced-motion:reduce){.wheel-center-halo{display:none}}

/* A small handwritten note on the upper-left shoulder, inside the drag region. */
.wheel-drag-tip{position:absolute;left:-8px;top:-71px;min-width:93.6px;max-width:139.2px;z-index:3;pointer-events:none;transform:rotate(-5deg);color:var(--accent);font-family:Lemi,sans-serif;line-height:1.6}
.drag-tip-title{display:block;font-size:17.28px;white-space:nowrap;letter-spacing:.2px}
.drag-tip-title::before{content:'';display:inline-block;width:4.8px;height:4.8px;background:var(--accent-2);border-radius:50%;vertical-align:middle;margin-right:4.8px}
.drag-tip-caption{display:block;font-size:14.4px;white-space:nowrap;color:var(--muted-ink);margin-left:9.6px}
.drag-tip-arrow{position:absolute;right:7px;bottom:-12px;width:30px;height:15.6px;border-bottom:1px solid var(--accent-2);border-right:1px solid var(--accent-2);border-radius:0 0 16.8px 0;transform:rotate(16deg)}
.drag-tip-arrow::after{content:'';position:absolute;left:0;bottom:-3px;width:6px;height:6px;border-left:1px solid var(--accent-2);border-bottom:1px solid var(--accent-2);transform:rotate(45deg)}

/* The four cards share one idle clock; each atlas keeps its own phase offset. */
.pet-thumb{position:relative;overflow:hidden;flex:none}
.pet-preview-atlas{display:block;max-width:none;max-height:none;transform-origin:0 0}

.pet-grid + .secondary{margin-top:28.8rpx}

/* Compact categories fill the expanded panel; collapse occupies the last cell. */
.category-picker{display:flex;align-items:flex-start;gap:7.2px;margin:19.2rpx 0 28.8rpx}
.category-picker .category-scroll{flex:1;min-width:0;width:0;margin:0}
.category-picker .category-row{padding:1.2px 0;gap:7.2px}
.category-picker .pill{flex:none;margin:0;min-height:36px;height:36px;padding:0 14.4px;font-size:14.4px;border-radius:14.4px;white-space:nowrap}
.category-picker .category-toggle{flex:none;width:52.8px;min-width:52.8px;min-height:36px;height:36px;padding:0;display:flex;gap:4.8px;border:1rpx solid var(--line);border-radius:14.4px;background:var(--surface-2);color:var(--accent);font-size:13.2px;line-height:1.2}
.category-chevron{width:6px;height:6px;border-right:1px solid currentColor;border-bottom:1px solid currentColor;transform:translateY(-1px) rotate(45deg);transition:transform 180ms ease}
.category-picker.is-expanded{display:block}
.category-picker.is-expanded .category-scroll{width:100%;white-space:normal}
.category-picker.is-expanded .category-row{display:flex;flex-wrap:wrap;gap:7.2px}
.category-picker.is-expanded .pill,.category-picker.is-expanded .category-row .category-toggle{width:calc((100% - 28.8px) / 5);min-width:0;padding:0;font-size:13.2px}
.category-picker.is-expanded .category-chevron{transform:translateY(1px) rotate(225deg)}

/* Keep gesture hit testing independent of clipped/translated image components. */
.wheel-gesture-surface{position:absolute;inset:0;z-index:20;pointer-events:auto;touch-action:none;background:rgba(255,255,255,0)}
.wheel-gesture-surface .theme-spin-icon,.wheel-gesture-surface .wheel-center text{pointer-events:none}

.wheel-gesture-surface .wheel-tap-hand{top:calc(var(--wheel-center-y) - 80px);z-index:3;pointer-events:none}
.theme-strawberry .wheel-gesture-surface .wheel-tap-hand{top:calc(var(--wheel-center-y) - 82px)}
.theme-lazy-cat .wheel-gesture-surface .wheel-tap-hand{top:calc(var(--wheel-center-y) - 76px)}

/* Compact vertical chrome on short phones; keep the disc and its labels readable. */
@media(max-height:680px){
  .wheel-topbar{height:0;margin:0}
  .wheel-topbar .brand-lockup{display:none}
  .app .wheel-topbar button.close{position:absolute;top:8px;right:16px;z-index:2}
  .wheel-intro{height:36px;margin-bottom:4px;padding-right:38px}
  .wheel-title{font-size:28px}
  .dinner-settings{min-height:38px;height:38px;padding-top:2px;padding-bottom:2px}
  .taste-heading{height:26px}
  .taste-actions .text-button{min-height:26px;height:26px}
}
