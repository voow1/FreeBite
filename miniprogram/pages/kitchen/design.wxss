.brand{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:44rpx}
.brand-lockup{display:flex;align-items:center;gap:14rpx;flex:none}
.brand-name{font-family:Lemi,sans-serif;font-size:36rpx;font-weight:700;letter-spacing:1rpx}
.brand-note{font-size:21rpx;max-width:260rpx;color:var(--muted-ink);text-align:right;line-height:1.5}
.kitchen-mark{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;background:var(--accent);color:var(--surface)}
.bowl-symbol{position:relative;width:30rpx;height:17rpx;border:3rpx solid currentColor;border-top-width:2rpx;border-radius:3rpx 3rpx 18rpx 18rpx;margin-top:9rpx}
.bowl-symbol::before,.bowl-symbol::after{content:'';position:absolute;width:2rpx;height:10rpx;background:currentColor;top:-16rpx;border-radius:2rpx;transform:rotate(18deg)}
.bowl-symbol::before{left:7rpx}.bowl-symbol::after{right:7rpx}
.home-heading{align-items:flex-end;margin-bottom:30rpx}.home-heading .title{font-size:42rpx;line-height:1.4;margin-top:10rpx}.home-heading .small{border:0;white-space:nowrap;padding:10rpx 18rpx}
.servings{background:var(--surface);border-radius:24rpx;padding:8rpx 12rpx 8rpx 22rpx;border:1rpx solid var(--line)}
.servings .pill{border:0;background:transparent;font-size:24rpx;min-width:44px;border-radius:18rpx}.servings .pill.active{background:var(--surface-2);color:var(--accent)}
.menu-card{border-radius:24rpx}.menu-card>text{padding:16rpx;font-size:25rpx}.menu-card.chosen::after{height:4rpx;box-shadow:none;bottom:5rpx;background:var(--accent)}
.dish-photo{border-radius:24rpx}.dish-name{font-weight:500}.pet-card{border-radius:26rpx}.theme-chip{border-radius:18rpx}
.bottom-nav{position:fixed;bottom:0;left:0;right:0;z-index:30;display:flex;background:var(--surface);border-top:1rpx solid var(--line);padding:14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom))}
.nav-item{flex:1;flex-direction:column;gap:8rpx;padding:8rpx 0;color:var(--muted-ink);font-size:22rpx;border-radius:22rpx}.nav-item.active{color:var(--accent)}
.wheel-screen{position:fixed;inset:0;z-index:45;background:var(--bg)}
.wheel-scroll{height:100%}.wheel-content{min-height:100%;padding:22rpx 36rpx calc(26rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column}
.wheel-topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:32rpx}.wheel-topbar .close{border:1rpx solid var(--line);border-radius:50%;color:var(--muted-ink);font-family:sans-serif;font-size:34rpx;padding:0;width:44px;height:44px}
.wheel-intro{position:relative;display:flex;align-items:center;margin-bottom:34rpx;min-height:218rpx}.wheel-intro-copy{position:relative;z-index:1;flex:1;min-width:0}.wheel-intro .eyebrow{font-size:23rpx;letter-spacing:2rpx;color:var(--muted-ink);margin-bottom:16rpx}
.wheel-title{display:block;font-family:Lemi,sans-serif;font-size:80rpx;line-height:1.05;font-weight:700;letter-spacing:1rpx}.accent-title{display:block;color:var(--accent)}.wheel-subtitle{display:block;font-size:23rpx;color:var(--muted-ink);margin-top:20rpx;white-space:nowrap}
.intro-pet{position:absolute;right:8rpx;bottom:38rpx;width:178rpx;height:178rpx;pointer-events:none}.intro-pet asset-image{position:relative;z-index:1}
.dinner-settings{display:flex;align-items:center;gap:10rpx;padding:8rpx 8rpx 8rpx 24rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:26rpx}
.setting-label{font-size:24rpx;color:var(--muted-ink);white-space:nowrap;margin-right:auto}.serving-segments{display:flex;gap:4rpx}.serving-choice{font-size:24rpx;min-width:44px;padding:10rpx 14rpx;border-radius:18rpx}.serving-choice.active{background:var(--surface-2);color:var(--accent);font-weight:700}.preferences-button{min-width:44px;width:44px;padding:0;color:var(--muted-ink);border-left:1rpx solid var(--line);border-radius:0}
.filter-icon{width:29rpx;height:20rpx;border-top:2rpx solid currentColor;border-bottom:2rpx solid currentColor;position:relative}.filter-icon::before,.filter-icon::after{content:'';position:absolute;width:6rpx;height:6rpx;border:2rpx solid currentColor;border-radius:50%;background:var(--surface)}.filter-icon::before{left:4rpx;top:-5rpx}.filter-icon::after{right:3rpx;bottom:-5rpx}
.taste-scroll{width:100%;margin:16rpx 0 24rpx;white-space:nowrap}.taste-row{display:inline-flex;gap:12rpx;padding:2rpx}.taste-choice{font-size:24rpx;border-radius:60rpx;padding:10rpx 25rpx;flex:none;color:var(--muted-ink);background:transparent;border:1rpx solid transparent}.taste-choice.active{color:var(--accent);border-color:var(--accent-2);background:var(--surface-2)}
.wheel-caption{display:flex;align-items:center;justify-content:space-between;padding:0 6rpx;margin:2rpx 0 20rpx}.wheel-caption-label{font-size:25rpx;font-weight:500}.wheel-caption .caption{font-size:22rpx}
.wheel-stage{position:relative;width:626rpx;height:626rpx;margin:0 auto 30rpx;border:1rpx solid var(--line);border-radius:50%;padding:6rpx;background:var(--surface)}
.wheel-disc{position:absolute;inset:6rpx;transition-property:transform;transition-timing-function:cubic-bezier(.12,.72,.12,1);border-radius:50%;overflow:hidden}
.wheel-canvas{display:block;width:100%;height:100%}.wheel-label{position:absolute;width:116rpx;text-align:center;pointer-events:none;transition-property:transform;transition-timing-function:cubic-bezier(.12,.72,.12,1);font-size:24rpx;line-height:1.6;font-weight:500;color:var(--ink);z-index:1}.wheel-label text{display:block;max-height:78rpx;overflow:hidden;word-break:break-all}
.wheel-pointer{position:absolute;left:50%;transform:translateX(-50%);width:24px;height:32px;z-index:13;pointer-events:none}
.pointer-spring{position:relative;width:100%;height:100%;transform-origin:50% 7px}
.pointer-blade{position:absolute;left:3px;top:7px;width:18px;height:18px;background:var(--surface);border:1px solid var(--accent);border-radius:10px 10px 3px 10px;transform:rotate(45deg);box-shadow:1px 1px 2px var(--line)}
.pointer-inlay{position:absolute;inset:3px;border-radius:6px 6px 2px 6px;background:linear-gradient(135deg,var(--accent-2),var(--accent))}
.pointer-pivot{position:absolute;left:6px;top:1px;width:12px;height:12px;border:1px solid var(--accent);border-radius:50%;background:var(--surface);display:flex;align-items:center;justify-content:center}
.pointer-pivot-dot{width:4px;height:4px;border-radius:50%;background:var(--accent)}
.pointer-beat-0{animation:pointer-tick-a ease-out both}.pointer-beat-1{animation:pointer-tick-b ease-out both}
@keyframes pointer-tick-a{0%{transform:rotate(0deg)}24%{transform:rotate(var(--pointer-kick))}62%{transform:rotate(var(--pointer-recoil))}100%{transform:rotate(0deg)}}
@keyframes pointer-tick-b{0%{transform:rotate(0deg)}24%{transform:rotate(var(--pointer-kick))}62%{transform:rotate(var(--pointer-recoil))}100%{transform:rotate(0deg)}}
.wheel-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:128rpx;height:128rpx;border-radius:50%;background:var(--surface);color:var(--accent);border:6rpx solid var(--bg);font-size:23rpx;padding:0;flex-direction:column;gap:10rpx;z-index:2;box-shadow:var(--shadow)}.wheel-center .bowl-symbol{width:36rpx;height:20rpx;margin-top:14rpx}.wheel-center>text{white-space:nowrap}
.wheel-bottom{margin-top:auto;padding-top:2rpx}.spin-button{width:100%;min-height:104rpx;border-radius:26rpx;display:flex;justify-content:center;gap:30rpx;font-size:30rpx;letter-spacing:1rpx}.button-arrow{font-family:sans-serif;font-size:36rpx;font-weight:400}.wheel-hint{display:block;text-align:center;font-size:22rpx;color:var(--muted-ink);margin:18rpx 0 0;line-height:1.7}
@media(max-height:820px){.wheel-topbar{margin-bottom:18rpx}.wheel-intro{margin-bottom:24rpx;min-height:180rpx}.wheel-title{font-size:72rpx}.wheel-intro .eyebrow{margin-bottom:10rpx}.wheel-subtitle{margin-top:12rpx}.intro-pet{width:156rpx;height:156rpx;bottom:26rpx}.taste-scroll{margin-bottom:14rpx}.wheel-stage{width:568rpx;height:568rpx;margin-bottom:22rpx}.wheel-caption{margin-bottom:16rpx}.wheel-label{font-size:23rpx;width:106rpx}.wheel-hint{margin-top:12rpx}}
@media(prefers-reduced-motion:reduce){.wheel-disc,.wheel-label{transition-duration:0ms!important}}

.taste-scroll::-webkit-scrollbar{display:none}.taste-scroll{scrollbar-width:none}
.wheel-line{display:block}
@media(min-width:410px) and (max-height:870px){.wheel-stage{width:568rpx;height:568rpx;margin-bottom:22rpx}.wheel-intro{margin-bottom:24rpx}.wheel-topbar{margin-bottom:22rpx}}

.menu-strip::-webkit-scrollbar,.category-scroll::-webkit-scrollbar{display:none}.menu-strip,.category-scroll{scrollbar-width:none}

/* Each pet has its own objects, surface shape and illustration language. */
.theme-brand-icon{width:60rpx;height:60rpx;flex:none}.theme-nav-icon{width:60rpx;height:60rpx;opacity:.66;transition:transform 160ms ease,opacity 160ms ease}.nav-item.active{background:var(--surface-2);font-weight:700}.nav-item.active .theme-nav-icon{opacity:1;transform:translateY(-3rpx)}.nav-item.active::after{content:'';width:12rpx;height:4rpx;border-radius:4rpx;background:var(--accent)}
.bottom-nav{max-width:620px;margin:auto;padding-top:10rpx}.nav-item{gap:1rpx;min-height:64px}.theme-spin-icon{width:64rpx;height:56rpx}.wheel-center{gap:2rpx}.theme-summary{display:flex;align-items:center;justify-content:space-between;background:var(--surface-2);border-radius:var(--card-radius);padding:24rpx 28rpx;gap:12rpx}.theme-summary .section-title,.theme-summary .caption{display:block}.theme-summary .section-title{font-family:Lemi,sans-serif;font-size:42rpx;margin:6rpx 0}.theme-decoration{width:110rpx;height:110rpx;flex:none}.pet-card{position:relative;background:var(--pet-bg);border-color:var(--pet-line);border-radius:var(--card-radius);color:var(--ink);padding:18rpx 12rpx}.pet-card.active{background:var(--pet-bg);border-color:var(--pet-accent);box-shadow:inset 0 0 0 1rpx var(--pet-accent)}.pet-theme-name{font-size:23rpx;color:var(--pet-accent);margin-top:4rpx}.pet-swatches{display:flex;gap:8rpx;margin:14rpx 0}.pet-swatches text{display:block;width:22rpx;height:12rpx;border-radius:6rpx}.pet-selected{font-size:21rpx;color:var(--pet-accent);padding:4rpx 18rpx;border:1rpx solid var(--pet-line);border-radius:30rpx}.pet-card.active .pet-selected{background:var(--pet-accent);color:#fff}.intro-pet asset-image{display:block;position:relative;width:100%;height:100%}.dinner-settings,.spin-button,.match-card,.input{border-radius:var(--card-radius)}
.theme-strawberry .theme-summary{border:1rpx dashed var(--line-strong)}.theme-milk-tea .theme-summary{border:2rpx solid var(--line)}.theme-lazy-cat .theme-summary{background:var(--surface);border-bottom:2rpx solid var(--line-strong)}.theme-baozi .theme-summary{border:1rpx solid var(--line);box-shadow:none}.theme-baozi .pet-card{border-width:2rpx}
@media(prefers-reduced-motion:reduce){.theme-nav-icon{transition:none}}

.reduce-motion button,.reduce-motion .theme-nav-icon{transition:none}

/* Keep the original mascot beside the wheel, independent of disc rotation. */
.wheel-stage{margin-top:190rpx;overflow:visible}
.wheel-pet{position:absolute;left:50%;top:-195rpx;width:208rpx;height:208rpx;transform:translateX(-50%);z-index:12;pointer-events:none}
/* All v1.16.0 sequences share the same 150/160 ground baseline. */
.wheel-pet asset-image{display:block;width:100%;height:100%;transform-origin:50% 86%}
/* Body motion comes from the coherent source frames, without a second bounce. */
.reduce-motion .wheel-pet asset-image{animation:none}
@media(prefers-reduced-motion:reduce){.wheel-pet asset-image{animation:none}}

@media(min-width:410px) and (max-height:870px){.wheel-stage{width:526rpx;height:526rpx}}

/* Native compact controls: all choices fit the page, with no horizontal drag. */
.app .servings{display:flex;flex-wrap:wrap;gap:4rpx;padding:10rpx}
.servings>.caption{width:100%;padding:6rpx 12rpx}
.app .servings button.pill{flex:1;min-width:0;padding:10rpx 4rpx}
.dinner-settings{display:block;padding:12rpx}
.setting-label{display:block;padding:4rpx 10rpx 8rpx;margin:0}
.serving-segments{display:flex;width:100%;gap:4rpx}
.app button.serving-choice{flex:1;min-width:0;padding:10rpx 4rpx}
.taste-heading,.taste-actions{display:flex;align-items:center;justify-content:space-between;gap:4rpx}
.taste-heading{margin-top:8rpx}
.taste-actions .text-button{font-size:23rpx;padding:8rpx 12rpx}
.taste-row{display:flex;flex-wrap:wrap;gap:10rpx;padding:0;margin:0 0 24rpx;white-space:normal}
.app button.taste-choice{flex:0 0 calc((100% - 30rpx)/4);min-width:0;min-height:44px;font-size:23rpx;padding:8rpx 2rpx;white-space:nowrap;border-color:var(--line)}
.app button.wheel-center{width:128rpx;height:128rpx;padding:0;flex:none}
.app button.spin-button{width:100%}
.app button.nav-item{flex:1;min-width:0}
.wheel-subtitle{white-space:normal}
.wheel-stage{flex-shrink:0}

/* The wheel is one fixed screen. Only separate preference sheets scroll. */
.wheel-screen{overflow:hidden}
.wheel-content{height:100%;min-height:0;overflow:hidden;padding:8px 20px 10px;display:flex;flex-direction:column}
.wheel-topbar{height:32px;flex:none;margin:0 0 4px}
.wheel-topbar .brand-name{font-size:17px}.wheel-topbar .theme-brand-icon{width:28px;height:28px}
.app .wheel-topbar button.close{width:30px;min-height:30px;height:30px;font-size:22px}
.wheel-intro{min-height:0;height:34px;flex:none;margin:0 0 6px}
.wheel-intro .eyebrow,.wheel-subtitle{display:none}
.wheel-title{font-size:26px;line-height:34px;letter-spacing:0;white-space:nowrap}
.accent-title{display:inline}
.dinner-settings{display:flex;align-items:center;flex:none;padding:2px 6px;height:36px;border-radius:12px}
.setting-label{font-size:12px;padding:0 8px 0 0;flex:none}
.serving-segments{flex:1;width:auto}
.app button.serving-choice{padding:2px;min-height:30px;font-size:13px}
.taste-heading{height:26px;margin:0;flex:none}.taste-heading .caption{font-size:11px}
.taste-actions .text-button{min-height:26px;padding:2px 6px;font-size:11px}
.taste-row{gap:4px;margin:0 0 5px;flex:none}
.app button.taste-choice{flex:0 0 calc((100% - 12px)/4);height:28px;min-height:28px;padding:0 2px;font-size:11px;border-radius:14px}
.wheel-caption{height:20px;flex:none;margin:0;padding:0}
.wheel-caption-label,.wheel-caption .caption{font-size:11px}
.wheel-play-area{flex:1;min-height:0;display:flex;align-items:center;justify-content:flex-end;flex-direction:column;padding-bottom:4px;touch-action:none}
.wheel-stage{margin:0 auto;flex:none;touch-action:none}
.wheel-pet{margin:0;overflow:hidden}
/* White rim = disc inset + 26/1024 of disc diameter. Pivot center is 7px down. */
.wheel-pointer{top:calc(2.924rpx + 1.2695% - 7px)}
.wheel-label{font-size:11px;width:18%;line-height:1.4}.wheel-label text{max-height:38px}
.app button.wheel-center{width:64px;height:64px;min-height:0;font-size:12px}
.wheel-center .theme-spin-icon{width:30px;height:26px}
.wheel-bottom{margin:6px 0 0;padding:0;flex:none}
.app button.spin-button{min-height:38px;height:38px;font-size:15px;padding:4px 12px;border-radius:14px}
.wheel-hint{font-size:10px;line-height:16px;margin:3px 0 0}
@media(max-height:520px){.wheel-topbar{display:none}.wheel-title{font-size:23px}.wheel-intro{height:30px}.wheel-caption{display:none}}

/* Only the fingertip enters the center button at the bottom of its float. */
.wheel-tap-hand{position:absolute;left:50%;top:calc(50% - 80px);width:56px;height:56px;margin-left:-28px;z-index:15;pointer-events:none;animation:wheel-tap-cue 1600ms ease-in-out infinite}
.theme-strawberry .wheel-tap-hand{top:calc(50% - 82px)}
.theme-lazy-cat .wheel-tap-hand{top:calc(50% - 76px)}
@keyframes wheel-tap-cue{0%,100%{transform:translateY(-4px)}55%{transform:translateY(3px)}}
.reduce-motion .wheel-tap-hand{animation:none}
@media(prefers-reduced-motion:reduce){.wheel-tap-hand{animation:none}}
