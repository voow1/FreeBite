.servings{display:flex;align-items:center;gap:10rpx;margin:20rpx 0 28rpx}.servings .caption{margin-right:auto;white-space:nowrap}.servings .pill{padding:12rpx 16rpx;min-width:92rpx}.menu-strip{width:100%;white-space:nowrap;margin:24rpx 0 0}.strip-inner{display:inline-flex;gap:16rpx;padding-bottom:12rpx}.menu-card{width:208rpx;border-radius:14rpx;overflow:hidden;background:var(--surface);position:relative}.menu-card>text{display:block;padding:16rpx 12rpx;font-size:24rpx;white-space:normal}.menu-card.chosen::after{content:'';position:absolute;bottom:0;left:20%;width:60%;height:8rpx;background:var(--accent-2);box-shadow:0 -4rpx 18rpx var(--accent-2);border-radius:50%}.menu-photo{height:142rpx}.category-scroll{white-space:nowrap;margin:24rpx 0}.category-row{display:inline-flex;gap:12rpx}.recipe-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32rpx 20rpx}.dish-photo{height:240rpx;border-radius:16rpx;overflow:hidden}.dish-name{display:block;font-size:29rpx;font-weight:700;margin:14rpx 0 4rpx}.more{margin-top:32rpx}.fridge-input{height:160rpx}.match-list{margin:28rpx 0}.match-card{padding:20rpx;background:var(--surface);border-radius:18rpx;margin-bottom:20rpx;border:1rpx solid var(--line)}.match-top{display:flex;gap:20rpx}.match-photo{width:150rpx;height:150rpx;flex:none;border-radius:12rpx;overflow:hidden}.match-copy{flex:1;min-width:0}.match-copy text{display:block}.shopping-item{display:flex;align-items:center;border-bottom:1rpx solid var(--line)}.shopping-name{display:flex;align-items:center;gap:16rpx;flex:1;min-height:100rpx}.shopping-name.done{text-decoration:line-through;color:var(--muted-ink)}.check{color:var(--accent);font-size:38rpx}.shopping-item button{width:88rpx;font-size:36rpx}.pet-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.pet-card{display:flex;flex-direction:column;background:var(--surface);border:2rpx solid var(--line);padding:16rpx 10rpx;font-size:25rpx}.pet-card.active{border-color:var(--accent);background:var(--surface-2)}.pet-thumb{width:180rpx;height:180rpx}.theme-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin-bottom:20rpx}.theme-chip{justify-content:flex-start;gap:14rpx;border:1rpx solid var(--line);background:var(--surface);font-size:24rpx;padding:10rpx 16rpx}.theme-chip.active{border-color:var(--accent);background:var(--surface-2)}.swatch{width:28rpx;height:28rpx;flex:none;border-radius:50%}.about-button{margin-top:40rpx}
