.servings{display:flex;align-items:center;gap:12rpx;margin:24rpx 0 33.6rpx}.servings .caption{margin-right:auto;white-space:nowrap}.servings .pill{padding:14.4rpx 19.2rpx;min-width:110.4rpx}.menu-strip{width:100%;white-space:nowrap;margin:28.8rpx 0 0}.strip-inner{display:inline-flex;gap:19.2rpx;padding-bottom:14.4rpx}.menu-card{width:249.6rpx;border-radius:16.8rpx;overflow:hidden;background:var(--surface);position:relative}.menu-card>text{display:block;padding:19.2rpx 14.4rpx;font-size:28.8rpx;white-space:normal}.menu-card.chosen::after{content:'';position:absolute;bottom:0;left:20%;width:60%;height:9.6rpx;background:var(--accent-2);box-shadow:0 -4rpx 18rpx var(--accent-2);border-radius:50%}.menu-photo{height:170.4rpx}.category-scroll{white-space:nowrap;margin:28.8rpx 0}.category-row{display:inline-flex;gap:14.4rpx}.recipe-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:38.4rpx 24rpx}.dish-photo{height:288rpx;border-radius:19.2rpx;overflow:hidden}.dish-name{display:block;font-size:34.8rpx;font-weight:700;margin:16.8rpx 0 4.8rpx}.more{margin-top:38.4rpx}.fridge-input{height:192rpx}.match-list{margin:33.6rpx 0}.match-card{padding:24rpx;background:var(--surface);border-radius:21.6rpx;margin-bottom:24rpx;border:1rpx solid var(--line)}.match-top{display:flex;gap:24rpx}.match-photo{width:180rpx;height:180rpx;flex:none;border-radius:14.4rpx;overflow:hidden}.match-copy{flex:1;min-width:0}.match-copy text{display:block}.shopping-item{display:flex;align-items:center;border-bottom:1rpx solid var(--line)}.shopping-name{display:flex;align-items:center;gap:19.2rpx;flex:1;min-height:120rpx}.shopping-name.done{text-decoration:line-through;color:var(--muted-ink)}.check{color:var(--accent);font-size:45.6rpx}.shopping-item button{width:105.6rpx;font-size:43.2rpx}.pet-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:19.2rpx}.pet-card{display:flex;flex-direction:column;background:var(--surface);border:2rpx solid var(--line);padding:19.2rpx 12rpx;font-size:30rpx}.pet-card.active{border-color:var(--accent);background:var(--surface-2)}.pet-thumb{width:216rpx;height:216rpx}.theme-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14.4rpx;margin-bottom:24rpx}.theme-chip{justify-content:flex-start;gap:16.8rpx;border:1rpx solid var(--line);background:var(--surface);font-size:28.8rpx;padding:12rpx 19.2rpx}.theme-chip.active{border-color:var(--accent);background:var(--surface-2)}.swatch{width:33.6rpx;height:33.6rpx;flex:none;border-radius:50%}.about-button{margin-top:48rpx}
