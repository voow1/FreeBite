<import src="../../templates/motion.wxml" />
<import src="../../templates/recipe.wxml" />
<page-meta page-style="{{wheelOpen || filtersOpen || addOpen ? 'overflow:hidden' : ''}}" />
<view bindtap="qTap" class="app q-app {{dishFlight ? 'has-dish-flight' : ''}} {{flightPhase === 'landed' ? 'dish-landed' : ''}} q-beat-{{qBeat}} q-action-{{qAction}} {{qPaused ? 'q-paused' : ''}} {{qReduced ? 'reduce-motion' : ''}} theme-{{themeId}} {{settings.reduceMotion ? 'reduce-motion' : ''}} {{wheelOpen || filtersOpen || addOpen ? 'modal-open' : ''}}" style="{{themeStyle}}">
  <view class="brand"><view class="brand-lockup"><view class="brand-icon-tile"><image class="theme-brand-icon" src="{{themeAssets.home}}" mode="aspectFit" /></view><view><text class="brand-kicker">DINNER DECISION</text><text class="brand-name">不牛马厨房</text></view></view><text class="brand-note">好好吃饭 · 慢慢生活</text></view>
  <view class="home-scene q-scene {{tab === 'home' ? 'q-active' : 'q-inactive'}}" wx:if="{{visited.home}}" hidden="{{tab !== 'home'}}">
    <view class="dinner-card">
    <view class="dinner-intro">
      <view class="section-head home-heading"><view class="dinner-heading-copy"><text class="eyebrow">TODAY'S TABLE · 今晚菜单</text><text class="title">今晚吃这个！</text></view><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="draw-entry" bindtap="openWheel"><view class="draw-entry-icon" aria-hidden="true"><view class="shuffle-symbol"></view></view><text>{{selected ? (selectedMenu.length > 1 ? '再抽一桌' : '再抽一道') : '打开转盘'}}</text></button><text class="pool-summary">当前菜池：{{poolCount}} / {{total}} 道</text></view>
    </view>
    <scroll-view wx:if="{{selectedMenu.length > 1}}" class="menu-strip" enhanced show-scrollbar="{{false}}" scroll-x scroll-left="{{menuScrollLeft}}" bindscroll="onMenuScroll" scroll-with-animation="{{!qReduced && !spinning}}"><view class="strip-inner"><view hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" wx:for="{{selectedMenu}}" wx:key="id" id="picked-{{item.id}}" class="q-clickable menu-card {{activeId === item.id ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="selectPicked"><view class="menu-photo"><asset-image class="asset-image" path="{{item.image}}" /></view><view class="menu-card-copy"><text class="menu-card-name">{{item.name}}</text><text class="menu-card-meta">{{item.time}} 分钟 · {{item.flavorText}}</text></view></view></view></scroll-view>
    <template wx:if="{{selected}}" is="recipe" data="{{selected,selectedMenu,standalone}}" />
    <view wx:else class="empty"><image class="q-empty-icon" src="{{themeAssets.spin}}" mode="aspectFit" /><text class="title">把纠结交给转盘</text><text>从 {{total}} 道家常菜里，选出今晚的好滋味。</text><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="primary" bindtap="openWheel">开始选菜</button></view>
    </view>
    <button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="recent-card full" data-tab="mine" bindtap="switchTab"><view class="recipe-section-icon history-icon" aria-hidden="true"><view class="recipe-line-icon history-symbol"></view></view><view class="recent-copy"><text class="section-title">最近做过</text><text class="caption">抽菜时会尽量避开最近 3 道。</text></view><text class="recent-count">{{history.length ? history.length + ' 道记录' : '暂无记录'}} ›</text></button>
  </view>
  <view class="q-scene {{tab === 'library' ? 'q-active' : 'q-inactive'}}" wx:if="{{visited.library}}" hidden="{{tab !== 'library'}}">
    <view class="section-head"><text class="title">今天想吃什么？</text><text class="caption">{{libraryTotal}} 道菜</text></view>
    <input data-focus="searchInput" bindfocus="qFocusInput" bindblur="qBlurInput" class="input {{qFocus === 'searchInput' ? 'q-focused' : ''}}" value="{{search}}" bindinput="searchInput" placeholder="搜菜名、食材或做法" maxlength="60" confirm-type="search" />
    <view class="category-picker {{categoriesExpanded ? 'is-expanded' : ''}}"><scroll-view class="category-scroll" enhanced show-scrollbar="{{false}}" scroll-x="{{!categoriesExpanded}}"><view class="category-row"><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="pill {{libraryTag === 'all' ? 'active' : ''}}" data-value="all" bindtap="setCategory">全部</button><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" wx:for="{{categories}}" wx:key="*this" class="pill {{libraryTag === item ? 'active' : ''}}" data-value="{{item}}" bindtap="setCategory">{{item}}</button><button wx:if="{{categoriesExpanded}}" class="category-toggle" hover-class="q-pressed" bindtap="toggleCategories" aria-label="收起分类" aria-expanded="{{true}}"><text>收起</text><view class="category-chevron" aria-hidden="true"></view></button></view></scroll-view><button wx:if="{{!categoriesExpanded}}" class="category-toggle" hover-class="q-pressed" bindtap="toggleCategories" aria-label="{{categoriesExpanded ? '收起分类' : '展开所有分类'}}" aria-expanded="{{categoriesExpanded}}"><view class="category-chevron" aria-hidden="true"></view><text>{{categoriesExpanded ? '收起' : '展开'}}</text></button></view>
    <view class="recipe-grid"><view hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" wx:for="{{library}}" wx:key="id" class="q-clickable dish-card {{index >= library.length - (library.length % 24 || 24) && index % 24 < 12 ? 'q-arrive' : ''}}" style="--q-delay:{{index % 12 * 22}}ms" data-id="{{item.id}}" bindtap="openRecipe"><view class="dish-photo"><asset-image class="asset-image" path="{{item.image}}" label="{{item.name}}" /></view><text class="dish-name">{{item.name}}</text><text class="caption">{{item.time}} 分钟 · {{item.flavorText}}</text></view></view>
    <button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" wx:if="{{library.length < libraryTotal}}" class="secondary full more" bindtap="loadMore">再看一些菜</button><view wx:elif="{{!library.length}}" class="empty"><image class="q-empty-icon" src="{{themeAssets.library}}" mode="aspectFit" /><text>暂时没有找到，换个关键词试试。</text></view>
  </view>
  <view class="q-scene {{tab === 'ingredients' ? 'q-active' : 'q-inactive'}}" wx:if="{{visited.ingredients}}" hidden="{{tab !== 'ingredients'}}">
    <text class="title">冰箱里，还有什么？</text><text class="intro">输入手头的食材，看看能做哪些菜。</text>
    <textarea data-focus="fridgeInput" bindfocus="qFocusInput" bindblur="qBlurInput" class="input {{qFocus === 'fridgeInput' ? 'q-focused' : ''}} fridge-input" value="{{settings.fridgeItems}}" bindinput="fridgeInput" placeholder="例如：番茄、鸡蛋、土豆" maxlength="600" />
    <view class="actions"><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="primary" bindtap="findFridge">看看能做什么</button><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="secondary" bindtap="openFilters">偏好与忌口</button></view>
    <view class="match-list"><view class="match-card {{index < 6 ? 'q-arrive' : ''}}" style="--q-delay:{{index * 35}}ms" wx:for="{{fridgeMatches}}" wx:key="id"><view hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="q-clickable match-top" data-id="{{item.id}}" bindtap="openRecipe"><view class="match-photo"><asset-image class="asset-image" path="{{item.image}}" /></view><view class="match-copy"><text class="section-title">{{item.name}}</text><text class="caption">已有：{{item.matched}}</text><text class="caption">{{item.missing ? '还差：' + item.missing : '主要食材齐啦'}}</text></view></view><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" wx:if="{{item.missingItems.length}}" class="text-button full" data-id="{{item.id}}" bindtap="addMissing">把缺少的食材加入清单 ＋</button></view></view>
    <view class="section-head"><text class="title">买菜清单</text><text class="caption">还差 {{shoppingRemaining}} 样</text></view>
    <view class="input-row"><input data-focus="shoppingInput" bindfocus="qFocusInput" bindblur="qBlurInput" class="input {{qFocus === 'shoppingInput' ? 'q-focused' : ''}}" value="{{shoppingInput}}" bindinput="shoppingInput" bindconfirm="addShopping" placeholder="添一样食材" maxlength="120" confirm-type="done" /><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="primary" bindtap="addShopping">添加</button></view>
    <view class="shopping-list"><view wx:for="{{shopping}}" wx:key="id" class="shopping-item {{qKey === item.id ? 'q-target' : ''}}"><view hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="q-clickable shopping-name {{item.done ? 'done' : ''}}" data-id="{{item.id}}" bindtap="toggleShopping"><text class="check">{{item.done ? '✓' : '○'}}</text><text>{{item.name}}</text></view><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="text-button" data-id="{{item.id}}" bindtap="removeShopping" aria-label="移除食材">×</button></view></view>
    <view wx:if="{{!shopping.length}}" class="empty compact"><image class="q-empty-icon" src="{{themeAssets.ingredients}}" mode="aspectFit" /><text>清单空空的，从菜谱里一键添加吧。</text></view><view class="actions"><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="secondary" bindtap="copyShopping">复制未买清单</button><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="text-button" bindtap="clearDone">清理已买</button></view>
  </view>
  <view class="q-scene {{tab === 'mine' ? 'q-active' : 'q-inactive'}}" wx:if="{{visited.mine}}" hidden="{{tab !== 'mine'}}">
    <text class="title">我的小厨房</text><text class="intro">选一位厨房搭子，住进它的小世界。</text>
    <view class="theme-summary"><view><text class="eyebrow">正在使用 · {{pet.name}}</text><text class="section-title">{{themeName}}</text><text class="caption">{{themeDescription}}</text></view><image class="theme-decoration" src="{{themeAssets.mine}}" mode="aspectFit" /></view>
    <view class="section-head"><text class="section-title">四位搭子，四种心情</text><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="text-button" bindtap="restoreAppearance">恢复默认</button></view><view class="pet-grid"><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" wx:for="{{pets}}" wx:key="id" class="pet-card q-arrive {{item.active ? 'active' : ''}}" style="{{item.cardStyle}}" data-id="{{item.id}}" bindtap="setPet"><view class="pet-thumb"><asset-image class="asset-image pet-preview-atlas" path="{{item.atlas}}" style="width:800%;height:800%;transform:translate({{-((petPreviewFrame + index * 4) % 8) * 12.5}}%,{{((petPreviewFrame + index * 4) % 16) >= 8 ? -12.5 : 0}}%)" bare="{{true}}" mode="scaleToFill" label="{{item.name}}" /></view><text>{{item.name}}</text><text class="pet-theme-name">{{item.themeName}}</text><view class="pet-swatches"><text wx:for="{{item.swatches}}" wx:for-item="color" wx:key="*this" style="background:{{color}}"></text></view><text class="pet-selected">{{item.active ? '使用中 ✓' : '选这个搭子'}}</text></button></view>
    <button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="secondary full" bindtap="openFilters">饮食偏好与忌口</button>
    <view class="section-head"><text class="section-title">我家的拿手菜</text><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="small secondary" bindtap="openAdd">添加菜谱 ＋</button></view>
    <view wx:for="{{customRecipes}}" wx:key="id" class="list-row"><text hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="q-clickable" data-id="{{item.id}}" bindtap="openRecipe">{{item.name}}</text><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="text-button" data-id="{{item.id}}" bindtap="removeCustom">删除</button></view><text wx:if="{{!customRecipes.length}}" class="caption">记下自己的做法，也能加入转盘。</text>
    <view class="section-head"><text class="section-title">最近做过</text><text class="caption">留住开火的小日子</text></view><view hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" wx:for="{{history}}" wx:key="id" class="q-clickable list-row" data-id="{{item.id}}" bindtap="openRecipe"><text>{{item.name}}</text><text class="caption">{{item.cookedAt}}</text></view><text wx:if="{{!history.length}}" class="caption">做完一道菜，点一下“今天做过了”。</text>
    <button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="text-button full about-button" bindtap="openAbout">关于厨房 · 隐私与素材说明</button>
  </view>
  <view class="bottom-nav"><button hover-class="none" class="nav-item {{tab === 'home' ? 'active' : ''}} {{qNavTab === 'home' ? 'q-nav-beat-' + qNavBeat : ''}}" data-tab="home" catchtap="switchTab"><image class="theme-nav-icon" src="{{themeAssets.home}}" mode="aspectFit" /><text>首页</text></button><button hover-class="none" class="nav-item {{tab === 'library' ? 'active' : ''}} {{qNavTab === 'library' ? 'q-nav-beat-' + qNavBeat : ''}}" data-tab="library" catchtap="switchTab"><image class="theme-nav-icon" src="{{themeAssets.library}}" mode="aspectFit" /><text>菜库</text></button><button hover-class="none" class="nav-item {{tab === 'ingredients' ? 'active' : ''}} {{qNavTab === 'ingredients' ? 'q-nav-beat-' + qNavBeat : ''}}" data-tab="ingredients" catchtap="switchTab"><image class="theme-nav-icon" src="{{themeAssets.ingredients}}" mode="aspectFit" /><text>食材</text></button><button hover-class="none" class="nav-item {{tab === 'mine' ? 'active' : ''}} {{qNavTab === 'mine' ? 'q-nav-beat-' + qNavBeat : ''}}" data-tab="mine" catchtap="switchTab"><image class="theme-nav-icon" src="{{themeAssets.mine}}" mode="aspectFit" /><text>我的</text></button></view>
  <view wx:if="{{wheelOpen}}" class="wheel-screen {{flightPhase === 'flying' ? 'flight-leaving' : ''}} {{spinning ? 'q-spinning' : ''}} {{qClosing === 'wheelOpen' ? 'q-closing' : ''}}">
    <view class="wheel-content" style="padding-bottom:{{safeBottom + 10}}px" catchtouchmove="noop">
      <view class="wheel-topbar"><view class="brand-lockup"><image class="theme-brand-icon" src="{{themeAssets.home}}" mode="aspectFit" /><text class="brand-name">不牛马厨房</text></view><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="text-button close" bindtap="closeWheel" disabled="{{spinning}}" aria-label="关闭转盘">×</button></view>
      <view class="wheel-intro"><view class="wheel-intro-copy"><text class="eyebrow">下班了，厨房见</text><text class="wheel-title">今天，也要<text class="accent-title">好好吃饭。</text></text><text class="wheel-subtitle">把纠结交给转盘，把时间留给自己。</text></view></view>
      <view class="dinner-settings"><text class="setting-label">今天几位</text><view class="serving-segments"><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" wx:for="{{servings}}" wx:key="*this" class="serving-choice {{settings.servingCount === item ? 'active' : ''}}" data-count="{{item}}" bindtap="setServing" disabled="{{spinning}}">{{item === 6 ? '6+' : item}}</button></view></view>
      <view class="taste-heading"><text class="caption">今天想吃什么口味</text><view class="taste-actions"><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="text-button" data-value="all" bindtap="toggleTaste" disabled="{{spinning}}">重置</button><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="text-button" bindtap="openFilters" disabled="{{spinning}}">更多偏好 ›</button></view></view>
      <view class="taste-row"><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="taste-choice {{!settings.tastes.length ? 'active' : ''}}" data-value="all" bindtap="toggleTaste" disabled="{{spinning}}">随便吃</button><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" wx:for="{{tastes}}" wx:key="name" class="taste-choice {{item.active ? 'active' : ''}}" data-value="{{item.name}}" bindtap="toggleTaste" disabled="{{spinning}}">{{item.name}}</button></view>
      <view class="wheel-caption"><text class="wheel-caption-label">今天的美味灵感</text><text class="caption">{{poolCount}} 道待选</text></view>
      <view class="wheel-play-area"><view class="wheel-stage" style="width:{{wheelSize}}px;height:{{wheelSize}}px;margin-top:{{wheelTop}}px"><view hidden="{{spinning || !wheelItems.length}}" class="wheel-drag-tip" style="width:{{(wheelSize - petSize) / 2 - 8}}px"><text class="drag-tip-title">手指在圆盘外</text><text class="drag-tip-caption">轻轻一滑也能转～</text><view class="drag-tip-arrow" aria-hidden="true"></view></view><view class="wheel-pet pet-{{pet.id}} pet-{{petState}}" style="width:{{petSize}}px;height:{{petSize}}px;top:{{-petSize * 150 / 160}}px"><asset-image class="asset-image" path="{{pet.atlas}}" style="{{pet.atlas ? 'width:' + (petSize * 8) + 'px;height:' + (petSize * 8) + 'px;transform:translate(' + (-petColumn * petSize) + 'px,' + (-petRow * petSize) + 'px)' : ''}}" bare="{{true}}" mode="scaleToFill" label="{{pet.name}}" /></view><view class="wheel-pointer"><view class="pointer-spring" style="transform:rotate({{pointerMotion ? pointerMotion.angle : 0}}deg);transition-duration:{{pointerMotion ? pointerMotion.duration : 180}}ms;transition-timing-function:{{pointerMotion ? 'linear' : 'ease-out'}}"><view class="pointer-blade"><view class="pointer-inlay"></view></view><view class="pointer-pivot"><view class="pointer-pivot-dot"></view></view></view></view><view class="wheel-disc" style="transform:rotate({{angle}}deg);transition-duration:{{spinDuration}}ms"><image wx:if="{{wheelImage}}" src="{{wheelImage}}" class="wheel-canvas" mode="aspectFit" /><view wx:for="{{wheelItems}}" wx:key="id" id="wheel-choice-{{index}}" class="wheel-label {{dishFlight && flightIndex === index ? 'flight-selected' : ''}}" style="left:{{item.x}}%;top:{{item.y}}%;transform:translate(-50%,-50%) rotate({{-angle}}deg);transition-duration:{{spinDuration}}ms"><text class="wheel-line" wx:for="{{item.lines}}" wx:for-item="line" wx:key="index">{{line}}</text></view></view><view wx:if="{{!spinning && wheelItems.length}}" class="wheel-center-halo" aria-hidden="true"></view></view><view class="wheel-gesture-surface" style="--wheel-center-y:{{wheelTop + wheelSize / 2}}px" catchtap="noop" catchtouchstart="touchStart" catchtouchmove="touchMove" catchtouchend="touchEnd" catchtouchcancel="touchCancel"><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="wheel-center" style="top:{{wheelTop + wheelSize / 2}}px" bindtap="tapWheelCenter" disabled="{{spinning || !wheelItems.length}}" aria-label="转一下"><image class="theme-spin-icon" src="{{themeAssets.spin}}" mode="aspectFit" /><text>{{spinning ? '选菜中' : '转一转'}}</text></button><image wx:if="{{!wheelHintDismissed && !spinning && wheelItems.length}}" class="wheel-tap-hand" src="/assets/themes/{{themeId}}/tap-hand.png" mode="aspectFit" aria-hidden="true" /></view></view>
      <view class="wheel-bottom"><text class="wheel-hint">{{wheelItems.length ? settings.servingCount > 1 ? '会按人数，搭配一桌有荤有素的菜' : '轻轻一转，今晚吃什么就有了答案' : '暂时没有符合偏好的菜，试着调整一下条件'}}</text><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" wx:if="{{!wheelItems.length}}" class="text-button full" bindtap="openFilters">调整偏好与忌口</button></view>
    </view>
  </view>
  <view wx:if="{{filtersOpen}}" class="scrim {{qClosing === 'filtersOpen' ? 'q-closing' : ''}}" bindtap="closeFilters"><view class="sheet" catchtap="noop"><view class="sheet-head"><text class="title">按自己的口味来</text><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="text-button close" bindtap="closeFilters">×</button></view><scroll-view class="sheet-scroll" scroll-y><view class="sheet-body">
    <text class="section-title">辣度</text><view class="chips"><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" wx:for="{{heatOptions}}" wx:key="value" class="pill {{settings.heat === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setHeat">{{item.label}}</button></view>
    <view wx:for="{{filterGroups}}" wx:key="label" wx:for-item="group" class="filter-group"><text class="section-title">{{group.label}}</text><view class="chips"><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" wx:for="{{group.tags}}" wx:key="name" class="pill {{item.active ? 'active' : ''}}" data-field="tags" data-value="{{item.name}}" bindtap="toggleFilter">{{item.name}}</button></view></view>
    <text class="section-title">不想吃的食材</text><view class="chips"><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" wx:for="{{avoidOptions}}" wx:key="value" class="pill {{item.active ? 'active' : ''}}" data-field="avoidFlags" data-value="{{item.value}}" bindtap="toggleFilter">{{item.label}}</button></view><input data-focus="setAvoidTerms" bindfocus="qFocusInput" bindblur="qBlurInput" class="input {{qFocus === 'setAvoidTerms' ? 'q-focused' : ''}}" value="{{settings.avoidTerms}}" bindinput="setAvoidTerms" placeholder="其他忌口，用逗号分隔，例如香菜、花生" maxlength="300" />
    <view class="setting-row"><text>术后恢复期筛选</text><switch checked="{{settings.recoveryMode}}" data-field="recoveryMode" bindchange="setSwitch" color="{{accent}}" /></view><view class="setting-row"><text>低碘预案筛选</text><switch checked="{{settings.lowIodinePlan}}" data-field="lowIodinePlan" bindchange="setSwitch" color="{{accent}}" /></view><text class="fine-print">仅辅助筛选菜谱，具体饮食安排请遵循医生建议；配料及实际用量仍需自行核对。</text>
    <view class="actions"><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="secondary" bindtap="resetFilters">重置全部条件</button><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="primary" bindtap="closeFilters">完成</button></view>
  </view></scroll-view></view></view>
  <view wx:if="{{addOpen}}" class="scrim {{qClosing === 'addOpen' ? 'q-closing' : ''}}" bindtap="closeAdd"><view class="sheet" catchtap="noop"><view class="sheet-head"><text class="title">记一道拿手菜</text><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="text-button close" bindtap="closeAdd">×</button></view><scroll-view class="sheet-scroll" scroll-y><form class="sheet-body custom-form" bindsubmit="saveCustom"><input data-focus="name" bindfocus="qFocusInput" bindblur="qBlurInput" class="input {{qFocus === 'name' ? 'q-focused' : ''}}" name="name" placeholder="菜名" maxlength="30" /><textarea data-focus="ingredients" bindfocus="qFocusInput" bindblur="qBlurInput" class="input {{qFocus === 'ingredients' ? 'q-focused' : ''}}" name="ingredients" placeholder="食材，用逗号分隔" maxlength="600" /><view class="input-row"><input data-focus="time" bindfocus="qFocusInput" bindblur="qBlurInput" class="input {{qFocus === 'time' ? 'q-focused' : ''}}" name="time" type="number" placeholder="用时（分钟）" maxlength="3" /><input data-focus="kcal" bindfocus="qFocusInput" bindblur="qBlurInput" class="input {{qFocus === 'kcal' ? 'q-focused' : ''}}" name="kcal" type="number" placeholder="热量估算（千卡）" maxlength="4" /></view><text class="caption">辣度</text><radio-group bindchange="qRadioInput" name="heat" class="chips"><label wx:for="{{heatOptions}}" wx:key="value" wx:if="{{item.value !== 'all'}}" class="radio-label {{qRadio === item.value ? 'q-radio-active' : ''}}"><radio value="{{item.value}}" checked="{{item.value === '0'}}" color="{{accent}}" />{{item.label}}</label></radio-group><textarea data-focus="steps" bindfocus="qFocusInput" bindblur="qBlurInput" class="input {{qFocus === 'steps' ? 'q-focused' : ''}} steps-input" name="steps" placeholder="每行写一个步骤" maxlength="3000" /><button hover-class="q-pressed" hover-start-time="0" hover-stay-time="110" class="primary full" form-type="submit">保存到我的菜库</button></form></scroll-view></view></view>
  <view wx:if="{{toast}}" class="toast q-toast-{{qBeat}}"><image class="q-toast-icon" src="{{themeAssets.spin}}" mode="aspectFit" /><text>{{toast}}</text></view>
  <view wx:if="{{flightRecipe}}" class="dish-preload" aria-hidden="true"><asset-image path="{{flightRecipe.image}}" bare="{{true}}" bind:ready="flightImageReady" /></view>
  <view wx:if="{{dishFlight}}" class="dish-flight {{flightPhase}}" catchtap="noop" catchtouchmove="noop" aria-hidden="true">
    <view class="dish-flight-card" style="{{flightStyle}}">
      <asset-image class="flight-photo" path="{{dishFlight.image}}" bare="{{true}}" mode="aspectFill" />
      <text class="flight-name">{{dishFlight.name}}</text>
    </view>
  </view>
  <template is="motion" data="{{qTouch,qReduced,qPaused}}" />
</view>
