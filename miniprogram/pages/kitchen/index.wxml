<import src="../../templates/recipe.wxml" />
<page-meta page-style="{{wheelOpen || filtersOpen || addOpen ? 'overflow:hidden' : ''}}" />
<view class="app theme-{{themeId}} {{settings.reduceMotion ? 'reduce-motion' : ''}} {{wheelOpen || filtersOpen || addOpen ? 'modal-open' : ''}}" style="{{themeStyle}}">
  <view class="brand"><view class="brand-lockup"><image class="theme-brand-icon" src="{{themeAssets.home}}" mode="aspectFit" /><text class="brand-name">不牛马厨房</text></view><text class="brand-note">好好吃饭 · 慢慢生活</text></view>
  <view wx:if="{{tab === 'home'}}">
    <view class="section-head home-heading"><view><text class="eyebrow">今晚的菜单</text><text class="title">吃点好的，犒劳自己。</text></view><button class="small secondary" bindtap="openWheel">换一桌</button></view>
    <view class="servings"><text class="caption">几个人吃</text><button wx:for="{{servings}}" wx:key="*this" class="pill {{settings.servingCount === item ? 'active' : ''}}" data-count="{{item}}" bindtap="setServing">{{item === 4 ? '4+' : item}} 人</button></view>
    <scroll-view wx:if="{{selectedMenu.length > 1}}" class="menu-strip" enhanced show-scrollbar="{{false}}" scroll-x scroll-into-view="{{activeScrollId}}" scroll-with-animation><view class="strip-inner"><view wx:for="{{selectedMenu}}" wx:key="id" id="picked-{{item.id}}" class="menu-card {{activeId === item.id ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="selectPicked"><view class="menu-photo"><asset-image path="{{item.image}}" /></view><text>{{item.name}}</text></view></view></scroll-view>
    <button wx:if="{{selectedMenu.length > 1}}" class="text-button full" bindtap="addMenuShopping">整桌食材加入购物清单 ＋</button>
    <template wx:if="{{selected}}" is="recipe" data="{{selected,selectedMenu,standalone}}" />
    <view wx:else class="empty"><text class="title">把纠结交给转盘</text><text>从 {{total}} 道家常菜里，选出今晚的好滋味。</text><button class="primary" bindtap="openWheel">开始选菜</button></view>
  </view>
  <view wx:if="{{tab === 'library'}}">
    <view class="section-head"><text class="title">今天想吃什么？</text><text class="caption">{{libraryTotal}} 道菜</text></view>
    <input class="input" value="{{search}}" bindinput="searchInput" placeholder="搜菜名、食材或做法" maxlength="60" confirm-type="search" />
    <scroll-view class="category-scroll" enhanced show-scrollbar="{{false}}" scroll-x><view class="category-row"><button class="pill {{libraryTag === 'all' ? 'active' : ''}}" data-value="all" bindtap="setCategory">全部</button><button wx:for="{{categories}}" wx:key="*this" class="pill {{libraryTag === item ? 'active' : ''}}" data-value="{{item}}" bindtap="setCategory">{{item}}</button></view></scroll-view>
    <view class="recipe-grid"><view wx:for="{{library}}" wx:key="id" class="dish-card" data-id="{{item.id}}" bindtap="openRecipe"><view class="dish-photo"><asset-image path="{{item.image}}" label="{{item.name}}" /></view><text class="dish-name">{{item.name}}</text><text class="caption">{{item.time}} 分钟 · {{item.heatText}}</text></view></view>
    <button wx:if="{{library.length < libraryTotal}}" class="secondary full more" bindtap="loadMore">再看一些菜</button><view wx:elif="{{!library.length}}" class="empty">暂时没有找到，换个关键词试试。</view>
  </view>
  <view wx:if="{{tab === 'ingredients'}}">
    <text class="title">冰箱里，还有什么？</text><text class="intro">输入手头的食材，看看能做哪些菜。</text>
    <textarea class="input fridge-input" value="{{settings.fridgeItems}}" bindinput="fridgeInput" placeholder="例如：番茄、鸡蛋、土豆" maxlength="600" />
    <view class="actions"><button class="primary" bindtap="findFridge">看看能做什么</button><button class="secondary" bindtap="openFilters">偏好与忌口</button></view>
    <view class="match-list"><view class="match-card" wx:for="{{fridgeMatches}}" wx:key="id"><view class="match-top" data-id="{{item.id}}" bindtap="openRecipe"><view class="match-photo"><asset-image path="{{item.image}}" /></view><view class="match-copy"><text class="section-title">{{item.name}}</text><text class="caption">已有：{{item.matched}}</text><text class="caption">{{item.missing ? '还差：' + item.missing : '主要食材齐啦'}}</text></view></view><button wx:if="{{item.missingItems.length}}" class="text-button full" data-id="{{item.id}}" bindtap="addMissing">把缺少的食材加入清单 ＋</button></view></view>
    <view class="section-head"><text class="title">买菜清单</text><text class="caption">还差 {{shoppingRemaining}} 样</text></view>
    <view class="input-row"><input class="input" value="{{shoppingInput}}" bindinput="shoppingInput" bindconfirm="addShopping" placeholder="添一样食材" maxlength="120" confirm-type="done" /><button class="primary" bindtap="addShopping">添加</button></view>
    <view class="shopping-list"><view wx:for="{{shopping}}" wx:key="id" class="shopping-item"><view class="shopping-name {{item.done ? 'done' : ''}}" data-id="{{item.id}}" bindtap="toggleShopping"><text class="check">{{item.done ? '✓' : '○'}}</text><text>{{item.name}}</text></view><button class="text-button" data-id="{{item.id}}" bindtap="removeShopping" aria-label="移除食材">×</button></view></view>
    <view wx:if="{{!shopping.length}}" class="empty compact">清单空空的，从菜谱里一键添加吧。</view><view class="actions"><button class="secondary" bindtap="copyShopping">复制未买清单</button><button class="text-button" bindtap="clearDone">清理已买</button></view>
  </view>
  <view wx:if="{{tab === 'mine'}}">
    <text class="title">我的小厨房</text><text class="intro">选一位厨房搭子，住进它的小世界。</text>
    <view class="theme-summary"><view><text class="eyebrow">正在使用 · {{pet.name}}</text><text class="section-title">{{themeName}}</text><text class="caption">{{themeDescription}}</text></view><image class="theme-decoration" src="{{themeAssets.mine}}" mode="aspectFit" /></view>
    <view class="section-head"><text class="section-title">四位搭子，四种心情</text><button class="text-button" bindtap="restoreAppearance">恢复默认</button></view><view class="pet-grid"><button wx:for="{{pets}}" wx:key="id" class="pet-card {{item.active ? 'active' : ''}}" style="{{item.cardStyle}}" data-id="{{item.id}}" bindtap="setPet"><view class="pet-thumb"><asset-image path="{{item.sources.idle}}" bare="{{true}}" mode="aspectFit" /></view><text>{{item.name}}</text><text class="pet-theme-name">{{item.themeName}}</text><view class="pet-swatches"><text wx:for="{{item.swatches}}" wx:for-item="color" wx:key="*this" style="background:{{color}}"></text></view><text class="pet-selected">{{item.active ? '使用中 ✓' : '选这个搭子'}}</text></button></view>
    <view class="setting-row"><text>减少动态效果</text><switch checked="{{settings.reduceMotion}}" data-field="reduceMotion" bindchange="setSwitch" color="{{accent}}" /></view>
    <button class="secondary full" bindtap="openFilters">饮食偏好与忌口</button>
    <view class="section-head"><text class="section-title">我家的拿手菜</text><button class="small secondary" bindtap="openAdd">添加菜谱 ＋</button></view>
    <view wx:for="{{customRecipes}}" wx:key="id" class="list-row"><text data-id="{{item.id}}" bindtap="openRecipe">{{item.name}}</text><button class="text-button" data-id="{{item.id}}" bindtap="removeCustom">删除</button></view><text wx:if="{{!customRecipes.length}}" class="caption">记下自己的做法，也能加入转盘。</text>
    <view class="section-head"><text class="section-title">最近做过</text><text class="caption">留住开火的小日子</text></view><view wx:for="{{history}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="openRecipe"><text>{{item.name}}</text><text class="caption">{{item.cookedAt}}</text></view><text wx:if="{{!history.length}}" class="caption">做完一道菜，点一下“今天做过了”。</text>
    <button class="text-button full about-button" bindtap="openAbout">关于厨房 · 隐私与素材说明</button>
  </view>
  <view class="bottom-nav"><button class="nav-item {{tab === 'home' ? 'active' : ''}}" data-tab="home" bindtap="switchTab"><image class="theme-nav-icon" src="{{themeAssets.home}}" mode="aspectFit" /><text>首页</text></button><button class="nav-item {{tab === 'library' ? 'active' : ''}}" data-tab="library" bindtap="switchTab"><image class="theme-nav-icon" src="{{themeAssets.library}}" mode="aspectFit" /><text>菜库</text></button><button class="nav-item {{tab === 'ingredients' ? 'active' : ''}}" data-tab="ingredients" bindtap="switchTab"><image class="theme-nav-icon" src="{{themeAssets.ingredients}}" mode="aspectFit" /><text>食材</text></button><button class="nav-item {{tab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="switchTab"><image class="theme-nav-icon" src="{{themeAssets.mine}}" mode="aspectFit" /><text>我的</text></button></view>
  <view wx:if="{{wheelOpen}}" class="wheel-screen">
    <scroll-view scroll-y class="wheel-scroll"><view class="wheel-content">
      <view class="wheel-topbar"><view class="brand-lockup"><image class="theme-brand-icon" src="{{themeAssets.home}}" mode="aspectFit" /><text class="brand-name">不牛马厨房</text></view><button class="text-button close" bindtap="closeWheel" disabled="{{spinning}}" aria-label="关闭转盘">×</button></view>
      <view class="wheel-intro"><view class="wheel-intro-copy"><text class="eyebrow">下班了，厨房见</text><text class="wheel-title">今天，也要<text class="accent-title">好好吃饭。</text></text><text class="wheel-subtitle">把纠结交给转盘，把时间留给自己。</text></view><view class="intro-pet"><asset-image path="{{petImage}}" bare="{{true}}" mode="aspectFit" /></view></view>
      <view class="dinner-settings"><text class="setting-label">今天几位</text><view class="serving-segments"><button wx:for="{{servings}}" wx:key="*this" class="serving-choice {{settings.servingCount === item ? 'active' : ''}}" data-count="{{item}}" bindtap="setServing" disabled="{{spinning}}">{{item === 4 ? '4+' : item}} 人</button></view><button class="preferences-button" bindtap="openFilters" disabled="{{spinning}}" aria-label="更多偏好"><view class="filter-icon"></view></button></view>
      <scroll-view class="taste-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="taste-row"><button class="taste-choice {{!settings.tastes.length ? 'active' : ''}}" data-value="all" bindtap="toggleTaste" disabled="{{spinning}}">随便吃点</button><button wx:for="{{tastes}}" wx:key="name" class="taste-choice {{item.active ? 'active' : ''}}" data-value="{{item.name}}" bindtap="toggleTaste" disabled="{{spinning}}">{{item.name}}</button></view></scroll-view>
      <view class="wheel-caption"><text class="wheel-caption-label">今天的美味灵感</text><text class="caption">{{poolCount}} 道待选</text></view>
      <view class="wheel-stage" bindtouchstart="touchStart" bindtouchend="touchEnd"><view class="wheel-pointer"></view><view class="wheel-disc" style="transform:rotate({{angle}}deg);transition-duration:{{spinDuration}}ms"><canvas type="2d" id="dishWheel" class="wheel-canvas"></canvas><view wx:for="{{wheelItems}}" wx:key="id" class="wheel-label" style="left:{{item.x}}%;top:{{item.y}}%;transform:translate(-50%,-50%) rotate({{-angle}}deg);transition-duration:{{spinDuration}}ms"><text class="wheel-line" wx:for="{{item.lines}}" wx:for-item="line" wx:key="index">{{line}}</text></view></view><button class="wheel-center" bindtap="spin" disabled="{{spinning || !wheelItems.length}}" aria-label="转一下"><image class="theme-spin-icon" src="{{themeAssets.spin}}" mode="aspectFit" /><text>{{spinning ? '选菜中' : '转一转'}}</text></button></view>
      <view class="wheel-bottom"><button class="primary spin-button" bindtap="spin" disabled="{{spinning || !wheelItems.length}}"><text>{{spinning ? '正在挑选今晚的好滋味…' : '帮我选今晚的菜'}}</text><text wx:if="{{!spinning}}" class="button-arrow">→</text></button><text class="wheel-hint">{{wheelItems.length ? settings.servingCount > 1 ? '会按人数，搭配一桌有荤有素的菜' : '轻轻一转，今晚吃什么就有了答案' : '暂时没有符合偏好的菜，试着调整一下条件'}}</text><button wx:if="{{!wheelItems.length}}" class="text-button full" bindtap="openFilters">调整偏好与忌口</button></view>
    </view></scroll-view>
  </view>
  <view wx:if="{{filtersOpen}}" class="scrim" bindtap="closeFilters"><view class="sheet" catchtap="noop"><view class="sheet-head"><text class="title">按自己的口味来</text><button class="text-button close" bindtap="closeFilters">×</button></view><scroll-view class="sheet-scroll" scroll-y><view class="sheet-body">
    <text class="section-title">辣度</text><view class="chips"><button wx:for="{{heatOptions}}" wx:key="value" class="pill {{settings.heat === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setHeat">{{item.label}}</button></view>
    <view wx:for="{{filterGroups}}" wx:key="label" wx:for-item="group" class="filter-group"><text class="section-title">{{group.label}}</text><view class="chips"><button wx:for="{{group.tags}}" wx:key="name" class="pill {{item.active ? 'active' : ''}}" data-field="tags" data-value="{{item.name}}" bindtap="toggleFilter">{{item.name}}</button></view></view>
    <text class="section-title">不想吃的食材</text><view class="chips"><button wx:for="{{avoidOptions}}" wx:key="value" class="pill {{item.active ? 'active' : ''}}" data-field="avoidFlags" data-value="{{item.value}}" bindtap="toggleFilter">{{item.label}}</button></view><input class="input" value="{{settings.avoidTerms}}" bindinput="setAvoidTerms" placeholder="其他忌口，用逗号分隔，例如香菜、花生" maxlength="300" />
    <view class="setting-row"><text>术后恢复期筛选</text><switch checked="{{settings.recoveryMode}}" data-field="recoveryMode" bindchange="setSwitch" color="{{accent}}" /></view><view class="setting-row"><text>低碘预案筛选</text><switch checked="{{settings.lowIodinePlan}}" data-field="lowIodinePlan" bindchange="setSwitch" color="{{accent}}" /></view><text class="fine-print">仅辅助筛选菜谱，具体饮食安排请遵循医生建议；配料及实际用量仍需自行核对。</text>
    <view class="actions"><button class="secondary" bindtap="resetFilters">重置全部条件</button><button class="primary" bindtap="closeFilters">完成</button></view>
  </view></scroll-view></view></view>
  <view wx:if="{{addOpen}}" class="scrim" bindtap="closeAdd"><view class="sheet" catchtap="noop"><view class="sheet-head"><text class="title">记一道拿手菜</text><button class="text-button close" bindtap="closeAdd">×</button></view><scroll-view class="sheet-scroll" scroll-y><form class="sheet-body custom-form" bindsubmit="saveCustom"><input class="input" name="name" placeholder="菜名" maxlength="30" /><textarea class="input" name="ingredients" placeholder="食材，用逗号分隔" maxlength="600" /><view class="input-row"><input class="input" name="time" type="number" placeholder="用时（分钟）" maxlength="3" /><input class="input" name="kcal" type="number" placeholder="热量估算（千卡）" maxlength="4" /></view><text class="caption">辣度</text><radio-group name="heat" class="chips"><label wx:for="{{heatOptions}}" wx:key="value" wx:if="{{item.value !== 'all'}}" class="radio-label"><radio value="{{item.value}}" checked="{{item.value === '0'}}" color="{{accent}}" />{{item.label}}</label></radio-group><textarea class="input steps-input" name="steps" placeholder="每行写一个步骤" maxlength="3000" /><button class="primary full" form-type="submit">保存到我的菜库</button></form></scroll-view></view></view>
  <view wx:if="{{toast}}" class="toast">{{toast}}</view>
</view>
