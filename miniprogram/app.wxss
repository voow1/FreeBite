@import "font.wxss";
page{background:#fbfcff;color:#344359;font-family:Lemi,"PingFang SC","Microsoft YaHei",sans-serif;font-size:33.6rpx;line-height:1.6}
view,button,input,textarea,scroll-view{box-sizing:border-box}button,input,textarea{font-family:inherit;font-size:33.6rpx}button{margin:0;padding:16.8rpx 26.4rpx;min-height:52.8px;line-height:1.5;border:0;border-radius:26.4rpx;display:flex;align-items:center;justify-content:center;background:transparent;color:inherit}button::after{border:0}button[disabled]{opacity:.48}button:active{opacity:.8}input,textarea{color:var(--ink)}
.app{min-height:100vh;max-width:620px;margin:auto;padding:28rpx 36rpx calc(196rpx + env(safe-area-inset-bottom));background:var(--bg);color:var(--ink)}
.title{display:block;font-size:50.4rpx;font-weight:700;line-height:1.35}.section-title{font-size:38.4rpx;font-weight:700}.caption{font-size:28.8rpx;color:var(--muted-ink);line-height:1.6}.eyebrow{display:block;font-size:27.6rpx;color:var(--accent);letter-spacing:2rpx}.intro{display:block;color:var(--muted-ink);margin:16.8rpx 0 33.6rpx}.section-head{display:flex;align-items:center;justify-content:space-between;gap:19.2rpx;margin:43.2rpx 0 24rpx}.section-head:first-child{margin-top:0}.centered{display:block;text-align:center}
.primary{color:var(--button-ink,var(--surface));background:var(--button-bg,var(--accent));font-weight:700}.secondary{color:var(--accent);background:var(--surface-2);border:1rpx solid var(--line)}.text-button{font-size:30rpx;color:var(--accent);padding:14.4rpx}.small{font-size:28.8rpx;padding:12rpx 24rpx}.full{width:100%}.actions{display:flex;gap:19.2rpx;margin:33.6rpx 0}.actions button{flex:1;min-width:0}.chips{display:flex;flex-wrap:wrap;gap:14.4rpx;margin:21.6rpx 0 31.2rpx}.pill{min-width:52.8px;flex:none;padding:14.4rpx 26.4rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:16.8rpx;font-size:30rpx}.pill.active{background:var(--button-bg);color:var(--button-ink);border-color:var(--accent)}
.input{width:100%;min-height:110.4rpx;border:1rpx solid var(--line);border-radius:26.4rpx;background:var(--surface);padding:26.4rpx;font-size:32.4rpx}.input-row{display:flex;gap:14.4rpx}.input-row .input{flex:1;min-width:0}.input-row button{flex:none}.empty{display:flex;flex-direction:column;align-items:center;gap:28.8rpx;text-align:center;color:var(--muted-ink);padding:108rpx 24rpx}.compact{padding:43.2rpx 12rpx}.fine-print{display:block;font-size:27.6rpx;color:var(--muted-ink);line-height:1.7}.tip{padding:28.8rpx;background:var(--surface-2);border-radius:26.4rpx;color:var(--accent);font-size:31.2rpx;margin:28.8rpx 0}.toast{position:fixed;bottom:calc(170rpx + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);max-width:85%;width:max-content;background:var(--toast-bg);color:var(--toast-ink);border-radius:26.4rpx;padding:24rpx 36rpx;font-size:31.2rpx;z-index:100;text-align:center}
.hero-photo{height:588rpx;position:relative;border-radius:33.6rpx;overflow:hidden;background:var(--surface-2)}.recipe-title{display:flex;justify-content:space-between;align-items:center;gap:21.6rpx;margin:31.2rpx 0 12rpx;font-size:55.2rpx;font-weight:700}.recipe-title text{flex:1;min-width:0}.metrics{display:flex;flex-wrap:wrap;gap:28.8rpx;font-size:30rpx;color:var(--muted-ink)}.tag{background:var(--surface-2);color:var(--accent);padding:7.2rpx 16.8rpx;font-size:27.6rpx;border-radius:9.6rpx}.ingredient{padding:14.4rpx 21.6rpx;border:1rpx solid var(--line);border-radius:14.4rpx;background:var(--surface)}.step{display:flex;align-items:flex-start;gap:24rpx;margin:0 0 36rpx}.step-number{display:flex;flex:none;align-items:center;justify-content:center;width:55.2rpx;height:55.2rpx;border-radius:50%;background:var(--surface-2);color:var(--accent);font-size:30rpx;font-weight:700}.step-text{flex:1;line-height:1.85;font-size:33.6rpx}.recipe-note{display:block;margin:24rpx 0}.source-list{margin-top:38.4rpx;padding-top:24rpx;border-top:1rpx solid var(--line)}.source-link{justify-content:flex-start;text-align:left;color:var(--accent);font-size:27.6rpx;padding:14.4rpx 0;min-height:52.8px}.footer-actions{margin:12rpx 0}.photo-arrow{position:absolute;top:50%;transform:translateY(-50%);width:52.8px;height:153.6rpx;border-radius:0;color:var(--accent);font-size:72rpx;font-family:sans-serif}.photo-arrow.prev{left:0;background:linear-gradient(90deg,rgba(255,255,255,.85),rgba(255,255,255,0))}.photo-arrow.next{right:0;background:linear-gradient(-90deg,rgba(255,255,255,.85),rgba(255,255,255,0))}
.setting-row,.list-row{display:flex;justify-content:space-between;align-items:center;gap:24rpx;padding:26.4rpx 0;min-height:120rpx;border-bottom:1rpx solid var(--line)}.list-row>text:first-child{flex:1;padding:14.4rpx 0}.setting-row switch{flex:none}.close{font-size:52.8rpx;width:52.8px;flex:none}.scrim{position:fixed;inset:0;background:var(--scrim);z-index:60;display:flex;align-items:flex-end}.sheet{width:100%;max-height:90vh;border-radius:33.6rpx 33.6rpx 0 0;background:var(--bg)}.sheet-head{display:flex;align-items:center;justify-content:space-between;padding:21.6rpx 38.4rpx;border-bottom:1rpx solid var(--line)}.sheet-head .title{font-size:43.2rpx}.sheet-scroll{height:72vh}.sheet-body{padding:28rpx 32rpx calc(32rpx + env(safe-area-inset-bottom))}.filter-group{margin:33.6rpx 0}.custom-form .input{margin-bottom:24rpx}.custom-form textarea{height:204rpx}.custom-form .steps-input{height:360rpx}.radio-label{display:flex;align-items:center;min-height:52.8px;font-size:28.8rpx}

button{transition:transform 160ms ease,opacity 160ms ease}button:active{transform:scale(.98)}button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.wheel-center:active{transform:translate(-50%,-50%) scale(.98)}.photo-arrow:active{transform:translateY(-50%) scale(.98)}
@media(prefers-reduced-motion:reduce){button{transition:none}}

/* Override WeChat v2's button:not([size=mini]) fixed 184px width. */
.app button{width:auto;margin-left:0;margin-right:0;min-width:0;box-sizing:border-box}
.app button.full{width:100%}
.app button.close{width:52.8px;flex:none}
.app button.photo-arrow{width:52.8px}
.app .recipe-title button{flex:none;white-space:nowrap}
.app .pill{min-width:52.8px}
