@import "font.wxss";
page{background:#fbfcff;color:#344359;font-family:Lemi,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}
view,button,input,textarea,scroll-view{box-sizing:border-box}button,input,textarea{font-family:inherit;font-size:28rpx}button{margin:0;padding:14rpx 22rpx;min-height:44px;line-height:1.5;border:0;border-radius:22rpx;display:flex;align-items:center;justify-content:center;background:transparent;color:inherit}button::after{border:0}button[disabled]{opacity:.48}button:active{opacity:.8}input,textarea{color:var(--ink)}
.app{min-height:100vh;max-width:620px;margin:auto;padding:28rpx 36rpx calc(196rpx + env(safe-area-inset-bottom));background:var(--bg);color:var(--ink)}
.title{display:block;font-size:42rpx;font-weight:700;line-height:1.35}.section-title{font-size:32rpx;font-weight:700}.caption{font-size:24rpx;color:var(--muted-ink);line-height:1.6}.eyebrow{display:block;font-size:23rpx;color:var(--accent);letter-spacing:2rpx}.intro{display:block;color:var(--muted-ink);margin:14rpx 0 28rpx}.section-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:36rpx 0 20rpx}.section-head:first-child{margin-top:0}.centered{display:block;text-align:center}
.primary{color:var(--button-ink,var(--surface));background:var(--button-bg,var(--accent));font-weight:700}.secondary{color:var(--accent);background:var(--surface-2);border:1rpx solid var(--line)}.text-button{font-size:25rpx;color:var(--accent);padding:12rpx}.small{font-size:24rpx;padding:10rpx 20rpx}.full{width:100%}.actions{display:flex;gap:16rpx;margin:28rpx 0}.actions button{flex:1;min-width:0}.chips{display:flex;flex-wrap:wrap;gap:12rpx;margin:18rpx 0 26rpx}.pill{min-width:44px;flex:none;padding:12rpx 22rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:14rpx;font-size:25rpx}.pill.active{background:var(--button-bg);color:var(--button-ink);border-color:var(--accent)}
.input{width:100%;min-height:92rpx;border:1rpx solid var(--line);border-radius:22rpx;background:var(--surface);padding:22rpx;font-size:27rpx}.input-row{display:flex;gap:12rpx}.input-row .input{flex:1;min-width:0}.input-row button{flex:none}.empty{display:flex;flex-direction:column;align-items:center;gap:24rpx;text-align:center;color:var(--muted-ink);padding:90rpx 20rpx}.compact{padding:36rpx 10rpx}.fine-print{display:block;font-size:23rpx;color:var(--muted-ink);line-height:1.7}.tip{padding:24rpx;background:var(--surface-2);border-radius:22rpx;color:var(--accent);font-size:26rpx;margin:24rpx 0}.toast{position:fixed;bottom:calc(170rpx + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);max-width:85%;width:max-content;background:var(--toast-bg);color:var(--toast-ink);border-radius:22rpx;padding:20rpx 30rpx;font-size:26rpx;z-index:100;text-align:center}
.hero-photo{height:490rpx;position:relative;border-radius:28rpx;overflow:hidden;background:var(--surface-2)}.recipe-title{display:flex;justify-content:space-between;align-items:center;gap:18rpx;margin:26rpx 0 10rpx;font-size:46rpx;font-weight:700}.recipe-title text{flex:1;min-width:0}.metrics{display:flex;flex-wrap:wrap;gap:24rpx;font-size:25rpx;color:var(--muted-ink)}.tag{background:var(--surface-2);color:var(--accent);padding:6rpx 14rpx;font-size:23rpx;border-radius:8rpx}.ingredient{padding:12rpx 18rpx;border:1rpx solid var(--line);border-radius:12rpx;background:var(--surface)}.step{display:flex;align-items:flex-start;gap:20rpx;margin:0 0 30rpx}.step-number{display:flex;flex:none;align-items:center;justify-content:center;width:46rpx;height:46rpx;border-radius:50%;background:var(--surface-2);color:var(--accent);font-size:25rpx;font-weight:700}.step-text{flex:1;line-height:1.85;font-size:28rpx}.recipe-note{display:block;margin:20rpx 0}.source-list{margin-top:32rpx;padding-top:20rpx;border-top:1rpx solid var(--line)}.source-link{justify-content:flex-start;text-align:left;color:var(--accent);font-size:23rpx;padding:12rpx 0;min-height:44px}.footer-actions{margin:10rpx 0}.photo-arrow{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:128rpx;border-radius:0;color:var(--accent);font-size:60rpx;font-family:sans-serif}.photo-arrow.prev{left:0;background:linear-gradient(90deg,rgba(255,255,255,.85),rgba(255,255,255,0))}.photo-arrow.next{right:0;background:linear-gradient(-90deg,rgba(255,255,255,.85),rgba(255,255,255,0))}
.setting-row,.list-row{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:22rpx 0;min-height:100rpx;border-bottom:1rpx solid var(--line)}.list-row>text:first-child{flex:1;padding:12rpx 0}.setting-row switch{flex:none}.close{font-size:44rpx;width:44px;flex:none}.scrim{position:fixed;inset:0;background:var(--scrim);z-index:60;display:flex;align-items:flex-end}.sheet{width:100%;max-height:90vh;border-radius:28rpx 28rpx 0 0;background:var(--bg)}.sheet-head{display:flex;align-items:center;justify-content:space-between;padding:18rpx 32rpx;border-bottom:1rpx solid var(--line)}.sheet-head .title{font-size:36rpx}.sheet-scroll{height:72vh}.sheet-body{padding:28rpx 32rpx calc(32rpx + env(safe-area-inset-bottom))}.filter-group{margin:28rpx 0}.custom-form .input{margin-bottom:20rpx}.custom-form textarea{height:170rpx}.custom-form .steps-input{height:300rpx}.radio-label{display:flex;align-items:center;min-height:44px;font-size:24rpx}

button{transition:transform 160ms ease,opacity 160ms ease}button:active{transform:scale(.98)}button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.wheel-center:active{transform:translate(-50%,-50%) scale(.98)}.photo-arrow:active{transform:translateY(-50%) scale(.98)}
@media(prefers-reduced-motion:reduce){button{transition:none}}

/* Override WeChat v2's button:not([size=mini]) fixed 184px width. */
.app button{width:auto;margin-left:0;margin-right:0;min-width:0;box-sizing:border-box}
.app button.full{width:100%}
.app button.close{width:44px;flex:none}
.app button.photo-arrow{width:44px}
.app .recipe-title button{flex:none;white-space:nowrap}
.app .pill{min-width:44px}
